const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

function getWorkspaces() {
  const output = execSync('yarn workspaces list --json', { encoding: 'utf-8' });
  return output
    .trim()
    .split('\n')
    .map(line => JSON.parse(line))
    .map(pkg => pkg.location);
}

/**
 * Bumps version by adding or incrementing the `-fix.N` suffix.
 *
 * Examples:
 *  3.0.3         → 3.0.3-fix.0
 *  3.0.3-fix.0   → 3.0.3-fix.1
 *  3.0.3-beta.1  → 3.0.3-fix.0
 */
function bumpVersion(version) {
  // Split out main semver and prerelease parts
  const [core, prerelease] = version.split('-');
  const [major, minor, patch] = core.split('.');

  if (prerelease && prerelease.startsWith('fix.')) {
    // If it's already a fix version, increment the number
    const currentFixNum = parseInt(prerelease.split('.')[1], 10);
    const nextFixNum = isNaN(currentFixNum) ? 0 : currentFixNum + 1;
    return `${major}.${minor}.${patch}-fix.${nextFixNum}`;
  } else {
    // Start fresh with fix.0
    return `${major}.${minor}.${patch}-fix.0`;
  }
}

function updatePackageVersion(pkgPath) {
  const pkgJsonPath = path.join(pkgPath, 'package.json');
  const pkgJson = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf-8'));

  const oldVersion = pkgJson.version;
  const newVersion = bumpVersion(oldVersion);

  pkgJson.stableVersion = oldVersion;
  pkgJson.version = newVersion;

  fs.writeFileSync(pkgJsonPath, JSON.stringify(pkgJson, null, 2) + '\n');
  console.log(`✔ Updated ${pkgJson.name}: ${oldVersion} → ${newVersion}`);
}

function main() {
  const packages = getWorkspaces();

  for (const pkg of packages) {
    updatePackageVersion(pkg);
  }

  console.log('✅ All package versions bumped with fix suffix.');
}

main();
