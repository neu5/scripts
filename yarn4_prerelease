const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

function getWorkspaces() {
  const output = execSync('yarn workspaces list --json', { encoding: 'utf-8' });
  return output
    .trim()
    .split('\n')
    .map(line => JSON.parse(line))
    .map(pkg => pkg.location);
}

function getShortCommitHash() {
  return execSync('git rev-parse --short HEAD', { encoding: 'utf-8' }).trim();
}

function bumpVersion(version, commitHash) {
  const [major, minor, patchAndPrerelease] = version.split('.');
  const [patch] = patchAndPrerelease.split('-');

  const newPatch = parseInt(patch, 10) + 1;
  return `${major}.${minor}.${newPatch}-${commitHash}`;
}

function updatePackageVersion(pkgPath, commitHash) {
  const pkgJsonPath = path.join(pkgPath, 'package.json');
  const pkgJson = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf-8'));

  const oldVersion = pkgJson.version;
  const newVersion = bumpVersion(oldVersion, commitHash);

  pkgJson.stableVersion = oldVersion;
  pkgJson.version = newVersion;

  fs.writeFileSync(pkgJsonPath, JSON.stringify(pkgJson, null, 2) + '\n');
  console.log(`✔ Updated ${pkgJson.name}: ${oldVersion} → ${newVersion}`);
}

function main() {
  const commitHash = getShortCommitHash();
  const packages = getWorkspaces();

  for (const pkg of packages) {
    updatePackageVersion(pkg, commitHash);
  }

  console.log('✅ All package versions bumped and stableVersion recorded.');
}

main();
