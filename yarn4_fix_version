const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

function getWorkspaces() {
  const output = execSync('yarn workspaces list --json', { encoding: 'utf-8' });
  return output
    .trim()
    .split('\n')
    .map(line => JSON.parse(line))
    .map(pkg => ({
      name: pkg.name,
      location: pkg.location
    }));
}

function run(cmd, opts = {}) {
  try {
    return execSync(cmd, { stdio: 'pipe', encoding: 'utf-8', ...opts }).trim();
  } catch (err) {
    console.error(`❌ Command failed: ${cmd}`);
    console.error(err.message);
    process.exit(1);
  }
}

function bumpVersion(version) {
  const [core, prerelease] = version.split('-');
  let [major, minor, patch] = core.split('.').map(Number);

  let stableVersion = core; // base stable version without prerelease
  let newVersion;

  if (prerelease && prerelease.startsWith('fix.')) {
    const currentFixNum = parseInt(prerelease.split('.')[1], 10) || 0;
    newVersion = `${major}.${minor}.${patch}-fix.${currentFixNum + 1}`;
  } else {
    patch += 1;
    newVersion = `${major}.${minor}.${patch}-fix.0`;
  }

  return { newVersion, stableVersion };
}

function updatePackageVersion(pkg) {
  const pkgJsonPath = path.join(pkg.location, 'package.json');
  const pkgJson = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf-8'));

  const oldVersion = pkgJson.version;
  const { newVersion, stableVersion } = bumpVersion(oldVersion);

  // ✅ Skip if version didn't change
  if (oldVersion === newVersion) {
    console.log(`↩️  Skipped ${pkg.name}: version unchanged (${oldVersion})`);
    return null;
  }

  pkgJson.stableVersion = stableVersion;
  pkgJson.version = newVersion;

  fs.writeFileSync(pkgJsonPath, JSON.stringify(pkgJson, null, 2) + '\n');
  console.log(`✔ Updated ${pkg.name}: ${oldVersion} → ${newVersion} (stable: ${stableVersion})`);

  return { name: pkg.name, newVersion, path: pkgJsonPath };
}

function createGitTag(packageName, version) {
  const tag = `${packageName}@${version}`;
  console.log(`🏷  Creating tag ${tag}`);
  run(`git tag -a "${tag}" -m "Release ${tag}"`);
  return tag;
}

function gitAdd(filePath) {
  run(`git add "${filePath}"`);
}

function gitCommit(message) {
  try {
    run(`git commit -m "${message}"`);
  } catch {
    console.log('ℹ️  Nothing to commit (maybe no version changes).');
  }
}

function pushGitChanges() {
  console.log('🚀 Pushing commits and tags to origin...');
  run('git push');
  run('git push --tags');
}

function main() {
  const packages = getWorkspaces();
  const taggedPackages = [];

  for (const pkg of packages) {
    const updated = updatePackageVersion(pkg);
    if (!updated) continue;

    gitAdd(updated.path);
    const tag = createGitTag(updated.name, updated.newVersion);
    taggedPackages.push(tag);
  }

  if (taggedPackages.length > 0) {
    gitCommit('chore: bump fix versions');
    pushGitChanges();
  } else {
    console.log('✅ No version changes detected. Nothing to commit or tag.');
  }

  if (taggedPackages.length > 0) {
    console.log('\n✅ Done! Created and pushed tags:');
    taggedPackages.forEach(t => console.log(`   - ${t}`));
  }
}

main();
