const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

function getWorkspaces() {
  const output = execSync('yarn workspaces list --json', { encoding: 'utf-8' });
  return output
    .trim()
    .split('\n')
    .map(line => JSON.parse(line))
    .map(pkg => pkg.location);
}

/**
 * Bumps version using the following logic:
 *  - 1.0.0         → 1.0.1-fix.0 (stableVersion = 1.0.0)
 *  - 1.0.1-fix.0   → 1.0.1-fix.1 (stableVersion = 1.0.1)
 *  - 1.0.1-fix.5   → 1.0.1-fix.6 (stableVersion = 1.0.1)
 *  - 1.0.1-beta.2  → 1.0.2-fix.0 (stableVersion = 1.0.1)
 */
function bumpVersion(version) {
  const [core, prerelease] = version.split('-');
  let [major, minor, patch] = core.split('.').map(Number);

  let stableVersion = core; // base stable version without prerelease
  let newVersion;

  if (prerelease && prerelease.startsWith('fix.')) {
    // Increment existing fix version
    const currentFixNum = parseInt(prerelease.split('.')[1], 10) || 0;
    newVersion = `${major}.${minor}.${patch}-fix.${currentFixNum + 1}`;
  } else {
    // Bump patch and start fix.0
    patch += 1;
    newVersion = `${major}.${minor}.${patch}-fix.0`;
  }

  return { newVersion, stableVersion };
}

function updatePackageVersion(pkgPath) {
  const pkgJsonPath = path.join(pkgPath, 'package.json');
  const pkgJson = JSON.parse(fs.readFileSync(pkgJsonPath, 'utf-8'));

  const oldVersion = pkgJson.version;
  const { newVersion, stableVersion } = bumpVersion(oldVersion);

  pkgJson.stableVersion = stableVersion;
  pkgJson.version = newVersion;

  fs.writeFileSync(pkgJsonPath, JSON.stringify(pkgJson, null, 2) + '\n');
  console.log(`✔ Updated ${pkgJson.name}: ${oldVersion} → ${newVersion} (stable: ${stableVersion})`);
}

function main() {
  const packages = getWorkspaces();

  for (const pkg of packages) {
    updatePackageVersion(pkg);
  }

  console.log('✅ All package versions bumped with fix suffix.');
}

main();
